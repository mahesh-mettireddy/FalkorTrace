# ============================================================================
# FalkorTrace — Environment Configuration (.env.example)
# Supports Local FalkorDB Docker (default) OR FalkorDB Cloud (app.falkordb.cloud)
# ============================================================================

# --- FalkorDB Connection ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
# Set to 1 for a strict live-DB submission/deployment. Local preview may use 0.
FALKORTRACE_STRICT_DB=0

# --- Browser/API security ---
# Required for public deployments. Leave empty only for local development.
FALKORTRACE_ADMIN_TOKEN=
# Comma-separated browser origins. Example: https://falkor-trace.vercel.app
FALKORTRACE_CORS_ORIGINS=http://localhost:8000

# --- Default Tenant Namespace (select_graph('falkortrace:<tenant>')) ---
DEFAULT_TENANT=killbill-prod

# --- Optional backend-only LLM Prose Enhancer (Guarded by accepts() Check) ---
# Configure these only in the backend environment or an ignored local .env file.
# Never paste an LLM key into the browser or commit it to the repository.
FALKORTRACE_LLM_PROVIDER=auto
FALKORTRACE_LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
