# ============================================================================
# FalkorTrace — Environment Configuration (.env.example)
# Supports Local FalkorDB Docker (default) OR FalkorDB Cloud (app.falkordb.cloud)
# ============================================================================

# --- FalkorDB Connection ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# --- Default Tenant Namespace (select_graph('falkortrace:<tenant>')) ---
DEFAULT_TENANT=killbill-prod

# --- Optional LLM Prose Enhancer (Guarded by accepts() Hallucination Check) ---
# Note: FalkorTrace works 100% deterministically even without any API keys!
GEMINI_API_KEY=
OPENAI_API_KEY=
